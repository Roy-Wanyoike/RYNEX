{
  "compilerOptions": {
    /* Emitted JS language level (plain browser scripts) */
    "target": "es2017",
    /* TS sources contain no import/export -> emit plain scripts, no module glue */
    "module": "es2015",
    "moduleResolution": "node",
    /* Type checking */
    "strict": true,
    /* Do not emit broken output if any file has a type error */
    "noEmitOnError": true,
    "skipLibCheck": true,
    "lib": ["dom", "es2017"],
    /* Compile TS in place: src/foo/foo.ts -> src/foo/foo.js (lands beside foo.html) */
    "rootDir": "./src",
    "outDir": "./src"
  },
  "include": ["src/**/*.ts"],
  /* Pin exclude explicitly: tsc auto-excludes outDir, and since outDir is ./src
     (in-place compile) the default exclude would drop every input (TS18003). */
  "exclude": ["node_modules"]
}
