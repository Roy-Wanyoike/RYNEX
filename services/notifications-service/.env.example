# RYNEX Notifications Service — environment template
# Copy to .env and fill in. NEVER commit the real .env.

# --- Server ---
PORT=4002

# --- Database (SQL Server) ---
DB_SERVER=localhost
DB_NAME=carshop
DB_USER=sa
DB_PWD=change_me_strong_password
DB_ENCRYPT=false

# --- SMTP (Gmail app password recommended) ---
EMAIL=your_address@gmail.com
PASSWORD=your_16_char_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Set to 'false' ONLY for local self-signed testing
SMTP_TLS_REJECT_UNAUTHORIZED=true

# --- Branding ---
APP_NAME=RYNEX
APP_LOGO_URL=
APP_URL=http://localhost:5500
