  "description": "Car Shop background email worker (node-cron + nodemailer + ejs + mssql)",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "concurrently \"tsc -w\" \"nodemon dist/server.js\"",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "echo \"No tests yet\" && exit 0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.0.3",
    "ejs": "^3.1.8",
    "express": "^4.18.2",
    "mssql": "^9.1.1",
    "node-cron": "^3.0.2",
    "nodemailer": "^6.9.1"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.1",
    "@types/express": "^4.17.17",
    "@types/mssql": "^8.1.2",
    "@types/node": "^18.0.0",
    "@types/node-cron": "^3.0.7",
    "@types/nodemailer": "^6.4.7",
    "concurrently": "^7.6.0",
    "nodemon": "^2.0.20",
    "typescript": "4.9.5"
  }
